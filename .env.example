# Server-only. Copy to .env locally. Never commit real values.
HOST=127.0.0.1
PORT=3100
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Production only: exact HTTPS frontend origin and secure session cookie.
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true

# Optional: Cloudflare Workers AI (the default provider remains OpenAI).
# AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=   (CLOUDFLARE_API_TOKEN also works)
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Cloudflare pilot is staff-only unless student access is enabled explicitly.
# AI_STUDENT_ENABLED=false
# Visitors (no account) follow AI_STUDENT_ENABLED unless this is false.
# AI_VISITOR_ENABLED=true

# AI usage limits (server/aiGuard.mjs). Defaults shown; counts are kept in
# SQLite (ai_usage) and survive a restart when the database file does.
# Whole project per day, in Cloudflare neurons (free allocation: 10000/day):
# AI_DAILY_NEURONS=8000
# All visitors together per day, in neurons:
# AI_VISITOR_DAILY_NEURONS=1000
# Model answers per account per day:
# AI_STUDENT_DAILY=15
# AI_STAFF_DAILY=60
# Per minute: per account / all visitors together / per visitor tab:
# AI_PER_MINUTE=5
# AI_VISITOR_PER_MINUTE=20
# AI_VISITOR_TAB_PER_MINUTE=3
# At the same time: in all / per account or visitor tab:
# AI_MAX_CONCURRENT=4
# AI_USER_CONCURRENT=1
# Time limit for one model call (ms):
# AI_TIMEOUT_MS=15000
